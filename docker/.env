# =====================================================================
# socialtokenizator — deployment configuration
#
# Copy this file:   cp .env.example .env
# Then edit values and run:   docker compose pull && docker compose up -d
# =====================================================================

# ---------- Application ----------
APP_NAME=socialtokenizator
APP_ENV=production
APP_DEBUG=false

# Generate one with:
#   docker run --rm ghcr.io/ivancarlosti/socialtokenizator:latest \
#     php -r 'echo "base64:".base64_encode(random_bytes(32))."\n";'
APP_KEY=

# ---------- Web Server & Reverse Proxy ----------
# Port exposed to the Docker host machine
PORT=8080
# If you are using a reverse proxy (like Nginx), you can define the domain name here
DOMAIN=socialtokenizator.example.com
# The fully-qualified URL used to generate links and OG/Twitter share metadata.
# Must match the public URL your users hit (https when fronted by TLS proxy).
APP_URL=https://socialtokenizator.example.com

# ---------- Logging ----------
LOG_CHANNEL=stderr
LOG_LEVEL=info

# ---------- Session ----------
SESSION_DRIVER=file
SESSION_LIFETIME=120
# Set to "true" only when serving over HTTPS (recommended in production).
SESSION_SECURE_COOKIE=true

# ---------- Database (MySQL / MariaDB, external) ----------
# Point these to your existing database server.
# The compose file does NOT include a MySQL service.
DB_CONNECTION=mysql
DB_HOST=mysql
DB_PORT=3306
DB_DATABASE=socialtokenizator
DB_USERNAME=stk
DB_PASSWORD=change-me

# ---------- Storage (Cloudflare R2, S3-compatible) ----------
# All image uploads are stored in R2.
FILESYSTEM_DISK=r2
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=socialtokenizator
# Account-level S3 endpoint, e.g. https://<account-id>.r2.cloudflarestorage.com
R2_ENDPOINT=
# Public read URL (custom domain recommended; otherwise the r2.dev subdomain).
# This is what gets embedded in OG / Twitter card meta tags.
# e.g. https://images.socialtokenizator.example.com  or  https://pub-xxxx.r2.dev
R2_PUBLIC_URL=
R2_REGION=auto

# ---------- Authentication ----------
# Authentication method (none, account, keycloak)
#   none     -> uploads are disabled, site is read-only/public
#   account  -> single login from ACCOUNT_LOGIN / ACCOUNT_PASSWORD below
#   keycloak -> OIDC SSO via Keycloak, restricted to KEYCLOAK_EMAIL_ACCOUNT
AUTH_METHOD=none

# Account auth settings (Basic username/password implementation)
ACCOUNT_LOGIN=
# Plaintext OR a bcrypt hash; the app auto-detects.
ACCOUNT_PASSWORD=
# Google reCAPTCHA v2 ("I'm not a robot"). Leave empty to disable.
RECAPTCHA_CLIENTID=
RECAPTCHA_CLIENTSECRET=

# Keycloak auth settings (OIDC/SAML)
KEYCLOAK_BASE_URL=https://sso.example.com
KEYCLOAK_REALM=YOURSSORealm
KEYCLOAK_CLIENT_ID=socialtokenizator
KEYCLOAK_CLIENT_SECRET=YOURKEYCLOAKCLIENTSECRET
# Must exactly match a Valid Redirect URI configured in the Keycloak client.
KEYCLOAK_REDIRECT_URI=https://socialtokenizator.example.com/auth/keycloak/callback
# Only this email is authorised as admin.
KEYCLOAK_EMAIL_ACCOUNT=youremail@example.com

# ---------- AI Translation (OpenAI-compatible API) ----------
# Uses the OpenAI chat completions standard. Works with DeepSeek, OpenAI, Groq, etc.
# Leave empty to disable the "Translate with AI" feature in admin forms.
AI_API_KEY=
# DeepSeek example: https://api.deepseek.com/v1
AI_API_URL=
# DeepSeek example: deepseek-v4-flash (cheapest, fast) or deepseek-chat (higher quality)
AI_MODEL=
